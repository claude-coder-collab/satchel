#include <winver.h>

IDI_ICON1 ICON "@ZP_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@ZP_VENDOR@"
            VALUE "FileDescription", "@ZP_RC_DESCRIPTION@"
            VALUE "FileVersion", "@ZP_VERSION@"
            VALUE "LegalCopyright", "Copyright (c) 2026 @ZP_VENDOR@"
            VALUE "ProductName", "Satchel"
            VALUE "ProductVersion", "@ZP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
